{
  "$schema": "https://unpkg.com/wrangler@4.131.1/config-schema.json",
  "name": "knowledge-vault",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "routes": [
    { "pattern": "i.fotira.com.br", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["cffyh@qq.com"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AUTH",
      "id": "37a6220378264cb28ab8d1e3b52bfdde"
    }
  ],
  "vars": {
    "AUTH_EMAIL": "cffyh@qq.com",
    "MAIL_FROM": "vault@fotira.com.br",
    "MAIL_FROM_NAME": "知识总库"
  }
}
